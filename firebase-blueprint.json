        "materialId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "materialTitle": { "type": "string", "minLength": 1, "maxLength": 140 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "responseText": { "type": "string", "maxLength": 4000 },
        "quizScore": { "type": "number" },
        "status": { "type": "string", "enum": ["submitted", "reviewed"] },
        "mentorFeedback": { "type": "string", "maxLength": 1500 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "materialId", "materialTitle", "userId", "studentName", "status", "createdAt", "updatedAt"]
    },
