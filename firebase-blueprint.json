      "required": ["id", "programmeName", "challengeDefaultDays", "weightRiskManagement", "weightDiscipline", "weightConsistency", "weightProfitability", "weightJournalCompletion", "requireMentorApproval", "minTradesForLeaderboard", "updatedBy", "updatedAt"]
    }
