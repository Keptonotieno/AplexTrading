        "pinned": { "type": "boolean" },
        "sessionDate": { "type": "string", "maxLength": 40 },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "body", "category", "pinned", "authorId", "authorName", "createdAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Opt-in anonymized or public ranking metrics without private balances or PII.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayAlias": { "type": "string", "minLength": 1, "maxLength": 80 },
        "growthPercent": { "type": "number" },
        "winRate": { "type": "number" },
        "consistencyScore": { "type": "number" },
        "riskScore": { "type": "number" },
        "disciplineScore": { "type": "number" },
        "overallScore": { "type": "number" },
        "improvementDelta": { "type": "number" },
        "eligibleTradesCount": { "type": "number" },
        "optedIn": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayAlias", "growthPercent", "winRate", "consistencyScore", "riskScore", "disciplineScore", "overallScore", "improvementDelta", "eligibleTradesCount", "optedIn", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative and security event log.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
