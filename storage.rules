rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isMentorAdmin() {
      return isVerified() &&
        request.auth.token.email in ['keptonokoth@gmail.com', 'keptonotieno@gmail.com'];
    }

    // Trade chart screenshots: screenshots/{userId}/{fileName}
    match /screenshots/{userId}/{fileName} {
      allow read: if isVerified() && (request.auth.uid == userId || isMentorAdmin());
      allow create, update: if isVerified()
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if isVerified() && (request.auth.uid == userId || isMentorAdmin());
    }
  }
}
